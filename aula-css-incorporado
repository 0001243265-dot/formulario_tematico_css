
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description"
        content="Arena Gamer e Loja Geek: jogos, consoles, acessórios e colecionáveis.">

    <title>Arena Gamer & Loja Geek</title>
    

    <style>
        
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background-color: #101018;
            color: #f5f5f5;
            line-height: 1.6;
        }

       
        h1 {
            color: #00f5ff;
        }

        .titulo-gamer {
            color: #ff00ff;
        }

    
        #id-destaque {
            color: #ffea00;
        }

        
        h1 {
            color: #ffffff;
        }

        .titulo-gamer {
            color: #ff00ff;
        }

       

        header {
            background-color: #19192b;
            color: #00f5ff;
            text-align: center;
            padding: 25px;
            border-bottom: 3px solid #a020f0;
        }

        header h1 {
            margin-bottom: 8px;
            font-size: 32px;
        }

        header p {
            color: #ffffff;
        }

       

        nav {
            background-color: #25253b;
            padding: 15px;
        }

        nav ul {
            list-style: none;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        nav a {
            color: #00f5ff;
            text-decoration: none;
            font-weight: bold;
        }

        nav a:hover,
        nav a:focus-visible {
            color: #ffffff;
            text-decoration: underline;
        }

       
        .container {
            width: 90%;
            max-width: 1100px;
            margin: 30px auto;
        }

       
        section {
            margin-bottom: 30px;
        }

        section h2 {
            color: #00f5ff;
            margin-bottom: 15px;
        }

        section > p {
            margin-bottom: 15px;
        }

       

        .lista-cards {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        
        .card {
            background-color: #1f1f35;
            color: #f5f5f5;
            border: 1px solid #696989;
            border-radius: 10px;
            padding: 20px;
            flex: 1 1 250px;
        }

        .card h3 {
            color: #d68aff;
            margin-bottom: 10px;
        }

        .card p {
            margin-bottom: 15px;
        }

        
        .tag {
            display: inline-block;
            background-color: #a020f0;
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        
        .btn {
            display: inline-block;
            background-color: #00cbd4;
            color: #101018;
            padding: 10px 16px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
        }

        .btn:hover,
        .btn:focus-visible {
            background-color: #ffffff;
            color: #101018;
        }

        

        aside {
            background-color: #25253b;
            color: #f5f5f5;
            padding: 20px;
            margin-bottom: 30px;
            border-left: 4px solid #00f5ff;
            border-radius: 8px;
        }

        aside h2 {
            color: #00f5ff;
            margin-bottom: 10px;
        }

       
        .formulario {
            background-color: #1f1f35;
            border: 1px solid #414160;
            border-radius: 10px;
            padding: 25px;
            max-width: 650px;
        }

        .campo-formulario {
            margin-bottom: 18px;
        }

        .campo-formulario label {
            display: block;
            color: #00f5ff;
            font-weight: bold;
            margin-bottom: 6px;
        }

        .input-formulario {
            display: block;
            width: 100%;
            padding: 12px;
            background-color: #101018;
            color: #ffffff;
            border: 1px solid #696989;
            border-radius: 6px;
            font-family: Arial, Helvetica, sans-serif;
        }

        .input-formulario:focus {
            outline: 2px solid #00f5ff;
            border-color: #00f5ff;
        }

        textarea.input-formulario {
            min-height: 120px;
            resize: vertical;
        }

        .botao-formulario {
            background-color: #a020f0;
            color: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 12px 22px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
        }

        .botao-formulario:hover {
            background-color: #7b18b8;
        }

        .formulario input:focus-visible,
        .formulario textarea:focus-visible,
        .formulario button:focus-visible {
            outline: 2px solid #00f5ff;
            outline-offset: 3px;
        }

       

        address {
            font-style: normal;
        }

        address a {
            color: #00f5ff;
        }


        footer {
            background-color: #19192b;
            color: #ffffff;
            border-top: 3px solid #a020f0;
            padding: 25px;
            text-align: center;
        }

      

        @media (max-width: 600px) {
            header h1 {
                font-size: 25px;
            }

            nav ul {
                flex-direction: column;
                align-items: center;
                gap: 12px;
            }

            .container {
                width: 94%;
            }

            .lista-cards {
                flex-direction: column;
            }

            .formulario {
                padding: 18px;
            }
        }
    </style>
</head>

<body>

    

    <header>
        <h1 id="id-destaque" class="titulo-gamer">
            Arena Gamer & Loja Geek
        </h1>

        <p>Seu universo de games, tecnologia e cultura geek!</p>

        <nav aria-label="Menu principal">
            <ul>
                <li><a href="#inicio">Início</a></li>
                <li><a href="#arena">Arena Gamer</a></li>
                <li><a href="#loja">Loja Geek</a></li>
                <li><a href="#promocoes">Promoções</a></li>
                <li><a href="#contato">Contato</a></li>
            </ul>
        </nav>
    </header>

   

    <main class="container">

       

        <section id="inicio">
            <h2>Bem-vindo à Arena Gamer!</h2>

            <p>
                Um espaço dedicado à diversão, à tecnologia e à cultura geek.
                Descubra jogos, participe de competições e encontre produtos
                para completar sua coleção.
            </p>

            <a class="btn" href="#loja">Conheça nossa loja</a>
        </section>

        

        <section id="arena">
            <h2>Nossa Arena Gamer</h2>

            <div class="lista-cards">

                <article class="card">
                    <span class="tag">Competição</span>

                    <h3>Jogos e campeonatos</h3>

                    <p>
                        Participe de partidas multiplayer, torneios e desafios
                        com outros jogadores.
                    </p>

                    <a class="btn" href="#contato">Saiba mais</a>
                </article>

                <article class="card">
                    <span class="tag">Tecnologia</span>

                    <h3>Estrutura gamer</h3>

                    <p>
                        Conheça nosso espaço com computadores, consoles,
                        controles e periféricos para jogos.
                    </p>

                    <a class="btn" href="#contato">Entre em contato</a>
                </article>

            </div>
        </section>

        

        <section id="loja">
            <h2>Loja Geek</h2>

            <div class="lista-cards">

                <article class="card">
                    <span class="tag">Games</span>

                    <h3>Consoles e acessórios</h3>

                    <p>
                        Encontre controles, headsets, teclados e outros
                        acessórios para sua experiência gamer.
                    </p>

                    <a class="btn" href="#contato">
                        Consultar produtos
                    </a>
                </article>

                <article class="card">
                    <span class="tag">Colecionáveis</span>

                    <h3>Produtos Geek</h3>

                    <p>
                        Confira camisetas, canecas, action figures e
                        produtos inspirados em animes, filmes e séries.
                    </p>

                    <a class="btn" href="#contato">
                        Tenho interesse
                    </a>
                </article>

            </div>
        </section>

       

        <section id="promocoes">
            <h2>Promoções e novidades</h2>

            <div class="lista-cards">

                <article class="card">
                    <span class="tag">Oferta</span>

                    <h3>Promoções especiais</h3>

                    <p>
                        Consulte nossa equipe para conhecer as ofertas
                        disponíveis em jogos, acessórios e colecionáveis.
                    </p>

                    <a class="btn" href="#contato">
                        Consultar ofertas
                    </a>
                </article>

                <article class="card">
                    <span class="tag">Novidade</span>

                    <h3>Lançamentos Geek</h3>

                    <p>
                        Fique por dentro das novidades do mundo gamer
                        e da cultura geek.
                    </p>

                    <a class="btn" href="#contato">Saiba mais</a>
                </article>

            </div>
        </section>

        

        <aside>
            <h2>Curiosidade Geek</h2>

            <p>
                Os videogames combinam criatividade, tecnologia,
                estratégia e diversão, conectando jogadores do mundo inteiro.
            </p>
        </aside>
<section id="video">
    <h2>Conheça nossa Arena Gamer</h2>

    <p>
        Assista ao vídeo e conheça o universo da Arena Gamer
        e da Loja Geek.
    </p>

    <div class="video-container">
        <video id="meuVideo"
               controls 
               autoplay 
               muted 
               playsinline 
               preload="auto" 
               poster="OIP.webp">
            <source src="videoplayback.mp4" type="video/mp4">
            Seu navegador não consegue reproduzir este vídeo.
        </video>
    </div>
</section>
       <section id="galeria">
    <h2>Galeria de Fotos</h2>

    <p>
        Confira nossa arena, nossos acessórios e os produtos
        da cultura geek.
    </p>

    <div class="galeria">
        <img
            class="foto-galeria"
            src="quarto-gamer-com-led-lilas.webp"
            alt="Espaço gamer com computadores e iluminação neon"
            loading="lazy">

        <section id="contato">
            <h2>Entre em contato</h2>

            <p>
                Preencha o formulário para tirar dúvidas sobre nossos
                produtos, jogos e eventos.
            </p>

            <form class="formulario" action="#" method="get">

                <div class="campo-formulario">
                    <label for="nome">Nome completo:</label>

                    <input
                        class="input-formulario"
                        type="text"
                        id="nome"
                        name="nome"
                        placeholder="Digite seu nome"
                        autocomplete="name"
                        required>
                </div>

                <div class="campo-formulario">
                    <label for="email">E-mail:</label>

                    <input
                        class="input-formulario"
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Digite seu e-mail"
                        autocomplete="email"
                        required>
                </div>

                <div class="campo-formulario">
                    <label for="assunto">Assunto:</label>

                    <input
                        class="input-formulario"
                        type="text"
                        id="assunto"
                        name="assunto"
                        placeholder="Ex.: produtos geek"
                        required>
                </div>

                <div class="campo-formulario">
                    <label for="mensagem">Mensagem:</label>

                    <textarea
                        class="input-formulario"
                        id="mensagem"
                        name="mensagem"
                        placeholder="Digite sua mensagem"
                        required></textarea>
                </div>

                <button
                    class="botao-formulario"
                    type="submit">
                    Enviar mensagem
                </button>

            </form>

            <p>
                E-mail para contato:
                <a href="mailto:contato@arenagamer.com.br">
                    contato@arenagamer.com.br
                </a>
            </p>

            <address>
                Atendimento: segunda a sábado, das 10h às 20h.
            </address>
        </section>

    </main>

   

    <footer>
        <p>&copy; 2026 Arena Gamer & Loja Geek.</p>
        <p>Todos os direitos reservados.</p>
        <p>Projeto desenvolvido para fins educacionais.</p>
    </footer>

</body>

</html>
